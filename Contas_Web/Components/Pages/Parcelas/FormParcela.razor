@page "/parcelas/novo"
@page "/parcelas/{Id:int}/editar"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inherits PaginaAutenticada
@inject ParcelasApiService ParcelasApi
@inject DividasApiService DividasApi
@inject ContasApiService ContasApi
@inject CategoriasApiService CategoriasApi

<PageTitle>@Titulo</PageTitle>

<h1 class="h3 mb-3">@Titulo</h1>

<Alerta Mensagem="@Mensagem" Sucesso="MensagemSucesso" OnFechar="LimparMensagem" />

@if (Carregando)
{
    <p>Carregando...</p>
}
else if (_naoEncontrado)
{
    <div class="alert alert-warning" role="alert">Parcela não encontrada.</div>
    <a class="btn btn-outline-secondary" href="/parcelas">Voltar</a>
}
else
{
    <div class="card shadow-sm" style="max-width: 720px;">
        <div class="card-body">
            <EditForm Model="_modelo" OnValidSubmit="SalvarAsync">
                <DataAnnotationsValidator />

                <div class="mb-3">
                    <label class="form-label" for="descricao">Descrição</label>
                    <InputText id="descricao" class="form-control" @bind-Value="_modelo.Descricao" />
                    <ValidationMessage For="() => _modelo.Descricao" />
                </div>

                <div class="mb-3">
                    <label class="form-label" for="divida">Dívida</label>
                    <InputSelect id="divida" class="form-select" @bind-Value="_modelo.IdDivida">
                        <option value="0">Selecione...</option>
                        @foreach (var divida in _dividas)
                        {
                            <option value="@divida.Id">@divida.Nome</option>
                        }
                    </InputSelect>
                </div>

                <div class="row g-3">
                    <div class="col-md-6 mb-3">
                        <label class="form-label" for="conta">Conta</label>
                        <InputSelect id="conta" class="form-select" @bind-Value="_modelo.IdConta">
                            <option value="0">Selecione...</option>
                            @foreach (var conta in _contas)
                            {
                                <option value="@conta.Id">@conta.Nome</option>
                            }
                        </InputSelect>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label" for="categoria">Categoria</label>
                        <InputSelect id="categoria" class="form-select" @bind-Value="_modelo.IdCategoria">
                            <option value="0">Selecione...</option>
                            @foreach (var categoria in _categorias)
                            {
                                <option value="@categoria.Id">@categoria.Nome</option>
                            }
                        </InputSelect>
                    </div>
                </div>

                <div class="row g-3">
                    <div class="col-md-6 mb-3">
                        <label class="form-label" for="valor">Valor</label>
                        <InputNumber id="valor" class="form-control" step="0.01" @bind-Value="_modelo.Valor" />
                        <ValidationMessage For="() => _modelo.Valor" />
                        <div class="form-text">Maior que zero.</div>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label" for="vencimento">Vencimento</label>
                        <InputDate id="vencimento" class="form-control" @bind-Value="_modelo.DataVencimento" />
                        <ValidationMessage For="() => _modelo.DataVencimento" />
                    </div>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary" disabled="@_salvando">
                        @(_salvando ? "Salvando..." : "Salvar")
                    </button>
                    <a class="btn btn-outline-secondary" href="/parcelas">Cancelar</a>
                </div>
            </EditForm>

            @if (Editando)
            {
                <p class="text-muted small mt-3 mb-0">
                    Pagar e desfazer pagamento continuam só na API
                    (PATCH api/parcelas/@Id/pagar), fora do escopo deste formulário.
                </p>
            }
        </div>
    </div>
}

@code {
    [Parameter] public int? Id { get; set; }

    private readonly AdicionarParcelaDto _modelo = new() { DataVencimento = DateTime.Today };

    private List<DividaDto> _dividas = [];
    private List<ContaDto> _contas = [];
    private List<CategoriaDto> _categorias = [];

    private bool _naoEncontrado;
    private bool _salvando;

    private bool Editando => Id.HasValue;

    private string Titulo => Editando ? "Editar parcela" : "Nova parcela";

    protected override async Task CarregarAsync()
    {
        var dividas = DividasApi.ObterTodosAsync();
        var contas = ContasApi.ObterTodosAsync();
        var categorias = CategoriasApi.ObterTodosAsync();

        _dividas = (await dividas)?.Where(d => d.Ativo).OrderBy(d => d.Nome).ToList() ?? [];
        _contas = (await contas)?.Where(c => c.Ativo).OrderBy(c => c.Nome).ToList() ?? [];
        _categorias = (await categorias)?.Where(c => c.Ativo).OrderBy(c => c.Nome).ToList() ?? [];

        if (!Editando)
            return;

        var parcela = await ParcelasApi.ObterPorIdAsync(Id!.Value);
        if (parcela is null)
        {
            _naoEncontrado = true;
            return;
        }

        _modelo.Descricao = parcela.Descricao;
        _modelo.IdDivida = parcela.IdDivida;
        _modelo.IdConta = parcela.IdConta;
        _modelo.IdCategoria = parcela.IdCategoria;
        _modelo.Valor = parcela.Valor;
        _modelo.DataVencimento = parcela.DataVencimento;
    }

    private async Task SalvarAsync()
    {
        LimparMensagem();

        // [Required] em int é no-op no DataAnnotationsValidator: a opção "Selecione..."
        // vale 0 e passaria pela validação do EditForm.
        if (_modelo.IdDivida == 0 || _modelo.IdConta == 0 || _modelo.IdCategoria == 0)
        {
            DefinirErro("Selecione a dívida, a conta e a categoria.");
            return;
        }

        _salvando = true;

        var resultado = Editando
            ? await ParcelasApi.AtualizarAsync(Id!.Value, new AtualizarParcelaDto
                {
                    IdDivida = _modelo.IdDivida,
                    IdCategoria = _modelo.IdCategoria,
                    IdConta = _modelo.IdConta,
                    Descricao = _modelo.Descricao,
                    Valor = _modelo.Valor,
                    DataVencimento = _modelo.DataVencimento
                })
            : await ParcelasApi.AdicionarAsync(_modelo);

        _salvando = false;

        if (resultado.Sucesso)
        {
            Navegacao.NavigateTo("/parcelas");
            return;
        }

        DefinirErro(resultado.Erro);
    }
}
