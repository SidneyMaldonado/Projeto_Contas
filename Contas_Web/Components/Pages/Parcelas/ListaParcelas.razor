@page "/parcelas"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inherits PaginaAutenticada
@using Microsoft.AspNetCore.Components.Server.ProtectedBrowserStorage
@inject ParcelasApiService ParcelasApi
@inject DividasApiService DividasApi
@inject ContasApiService ContasApi
@inject CategoriasApiService CategoriasApi
@inject ProtectedSessionStorage Armazenamento

<PageTitle>Parcelas</PageTitle>

<h1 class="h3 mb-3">Parcelas</h1>

<Alerta Mensagem="@Mensagem" Sucesso="MensagemSucesso" OnFechar="LimparMensagem" />

@if (Carregando)
{
    <p>Carregando...</p>
}
else if (_parcelas is null)
{
    <div class="alert alert-danger" role="alert">
        Não foi possível carregar as parcelas. Tente novamente mais tarde.
    </div>
}
else
{
    <div class="row g-2 align-items-center mb-3">
        <div class="col-sm-6 col-lg-4">
            <select class="form-select" @bind="_idDividaSelecionada" aria-label="Filtrar por dívida">
                <option value="">Todas as dívidas</option>
                @foreach (var divida in _dividas)
                {
                    <option value="@divida.Id">@divida.Nome</option>
                }
            </select>
        </div>

        <div class="col-auto">
            <button type="button" class="btn btn-outline-primary" @onclick="FiltrarAsync">Filtrar</button>
        </div>

        <div class="col-auto">
            <button type="button" class="btn btn-outline-secondary" @onclick="LimparFiltroAsync"
                    disabled="@(_idDividaAplicada is null && _idDividaSelecionada is null)">
                Limpar filtro
            </button>
        </div>
    </div>

    <BarraFiltro @bind-Texto="_filtro" @bind-MostrarInativos="_mostrarInativos"
                 Placeholder="Filtrar por descrição" UrlNovo="@UrlNovo" />

    @if (!Filtradas.Any())
    {
        <p class="text-muted">Nenhuma parcela encontrada.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-sm table-hover align-middle">
                <thead>
                    <tr>
                        <th>Descrição</th>
                        <th>Dívida</th>
                        <th>Conta</th>
                        <th>Categoria</th>
                        <th class="text-end">Valor</th>
                        <th>Vencimento</th>
                        <th>Pagamento</th>
                        <th>Situação</th>
                        <th class="text-end">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var parcela in Filtradas)
                    {
                        <tr>
                            <td>@parcela.Descricao</td>
                            <td>@Nome(_nomesDividas, parcela.IdDivida)</td>
                            <td>@Nome(_contas, parcela.IdConta)</td>
                            <td>@Nome(_categorias, parcela.IdCategoria)</td>
                            <td class="text-end">@Formato.Moeda(parcela.Valor)</td>
                            <td>@Formato.Data(parcela.DataVencimento)</td>
                            <td>
                                <PagamentoParcela Pago="parcela.Pago"
                                                  DataPagamento="parcela.DataPagamento"
                                                  OnPagar="data => PagarAsync(parcela.Id, data)"
                                                  OnDesfazer="() => DesfazerPagamentoAsync(parcela.Id)" />
                            </td>
                            <td><Situacao Ativo="parcela.Ativo" /></td>
                            <td class="text-end">
                                <AcoesLinha UrlEditar="@($"/parcelas/{parcela.Id}/editar")"
                                            Ativo="parcela.Ativo"
                                            OnInativar="() => InativarAsync(parcela.Id)"
                                            OnExcluir="() => ExcluirAsync(parcela.Id)" />
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <p class="text-muted small">@Filtradas.Count() de @_parcelas.Count registro(s).</p>
    }
}

@code {
    /// <summary>Chave do filtro de dívida no ProtectedSessionStorage; mantém o filtro entre navegações.</summary>
    private const string ChaveFiltroDivida = "parcelas-filtro-divida";

    /// <summary>Quando informado na querystring, restringe a lista às parcelas dessa dívida.</summary>
    [SupplyParameterFromQuery(Name = "idDivida")]
    public int? IdDivida { get; set; }

    private List<ParcelaDto>? _parcelas;

    private List<DividaDto> _dividas = [];
    private Dictionary<int, string> _nomesDividas = [];
    private Dictionary<int, string> _contas = [];
    private Dictionary<int, string> _categorias = [];

    private string _filtro = string.Empty;
    private bool _mostrarInativos;

    /// <summary>Dívida escolhida na dropdown, ainda não aplicada.</summary>
    private int? _idDividaSelecionada;

    /// <summary>Dívida do filtro em vigor, aplicada ao clicar em Filtrar.</summary>
    private int? _idDividaAplicada;

    private bool _filtroRestaurado;

    protected override async Task CarregarAsync()
    {
        await RestaurarFiltroAsync();

        var parcelas = ParcelasApi.ObterTodosAsync();
        var dividas = DividasApi.ObterTodosAsync();
        var contas = ContasApi.ObterTodosAsync();
        var categorias = CategoriasApi.ObterTodosAsync();

        _parcelas = (await parcelas)?.OrderBy(p => p.DataVencimento).ToList();
        _dividas = (await dividas)?.OrderBy(d => d.Nome).ToList() ?? [];
        _nomesDividas = _dividas.ToDictionary(d => d.Id, d => d.Nome);
        _contas = (await contas)?.ToDictionary(c => c.Id, c => c.Nome) ?? [];
        _categorias = (await categorias)?.ToDictionary(c => c.Id, c => c.Nome) ?? [];

        // Filtro persistido de uma dívida que não existe mais volta a "todas as dívidas".
        if (_idDividaAplicada is not null && _dividas.Count > 0
            && !_nomesDividas.ContainsKey(_idDividaAplicada.Value))
        {
            await AplicarFiltroAsync(null);
        }
    }

    /// <summary>
    /// Recupera o filtro uma única vez por circuito: a querystring (vinda da lista de dívidas)
    /// tem prioridade e passa a ser o filtro persistido; sem ela, vale o que está no storage.
    /// </summary>
    private async Task RestaurarFiltroAsync()
    {
        if (_filtroRestaurado)
            return;

        _filtroRestaurado = true;

        if (IdDivida is not null)
        {
            await AplicarFiltroAsync(IdDivida);
            return;
        }

        var salvo = await Armazenamento.GetAsync<int>(ChaveFiltroDivida);
        if (salvo.Success)
        {
            _idDividaAplicada = salvo.Value;
            _idDividaSelecionada = salvo.Value;
        }
    }

    private Task FiltrarAsync() => AplicarFiltroAsync(_idDividaSelecionada);

    private Task LimparFiltroAsync() => AplicarFiltroAsync(null);

    /// <summary>Aplica o filtro escolhido e o persiste (ou o remove, quando limpo).</summary>
    private async Task AplicarFiltroAsync(int? idDivida)
    {
        _idDividaAplicada = idDivida;
        _idDividaSelecionada = idDivida;

        if (idDivida is null)
            await Armazenamento.DeleteAsync(ChaveFiltroDivida);
        else
            await Armazenamento.SetAsync(ChaveFiltroDivida, idDivida.Value);
    }

    /// <summary>Leva o filtro atual para o formulário, que já abre com a dívida escolhida.</summary>
    private string UrlNovo => _idDividaAplicada is null
        ? "/parcelas/novo"
        : $"/parcelas/novo?idDivida={_idDividaAplicada}";

    private IEnumerable<ParcelaDto> Filtradas => (_parcelas ?? [])
        .Where(p => _idDividaAplicada is null || p.IdDivida == _idDividaAplicada)
        .Where(p => _mostrarInativos || p.Ativo)
        .Where(p => Filtro.Corresponde(_filtro, p.Descricao));

    private static string Nome(Dictionary<int, string> origem, int id) =>
        origem.TryGetValue(id, out var nome) ? nome : $"#{id}";

    private async Task PagarAsync(int id, DateTime dataPagamento)
        => await AplicarResultadoAsync(
            await ParcelasApi.PagarAsync(id, new PagarParcelaDto { DataPagamento = dataPagamento }),
            "Pagamento registrado.");

    private async Task DesfazerPagamentoAsync(int id)
        => await AplicarResultadoAsync(
            await ParcelasApi.DesfazerPagamentoAsync(id), "Pagamento desfeito.");

    private async Task InativarAsync(int id)
        => await AplicarResultadoAsync(await ParcelasApi.InativarAsync(id), "Parcela inativada.");

    private async Task ExcluirAsync(int id)
        => await AplicarResultadoAsync(await ParcelasApi.ExcluirAsync(id), "Parcela excluída.");
}
