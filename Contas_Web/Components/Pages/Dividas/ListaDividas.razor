@page "/dividas"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inherits PaginaAutenticada
@inject DividasApiService DividasApi
@inject ContasApiService ContasApi
@inject CategoriasApiService CategoriasApi
@inject CredoresApiService CredoresApi

<PageTitle>Dívidas</PageTitle>

<h1 class="h3 mb-3">Dívidas</h1>

<Alerta Mensagem="@Mensagem" Sucesso="MensagemSucesso" OnFechar="LimparMensagem" />

@if (Carregando)
{
    <p>Carregando...</p>
}
else if (_dividas is null)
{
    <div class="alert alert-danger" role="alert">
        Não foi possível carregar as dívidas. Tente novamente mais tarde.
    </div>
}
else
{
    <BarraFiltro @bind-Texto="_filtro" @bind-MostrarInativos="_mostrarInativos"
                 Placeholder="Filtrar por nome" UrlNovo="/dividas/novo" />

    @if (!Filtradas.Any())
    {
        <p class="text-muted">Nenhuma dívida encontrada.</p>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-sm table-hover align-middle">
                <thead>
                    <tr>
                        <th>Nome</th>
                        <th>Conta</th>
                        <th>Categoria</th>
                        <th>Credor</th>
                        <th class="text-end">Valor</th>
                        <th class="text-end">Parcelas</th>
                        <th>1º vencimento</th>
                        <th>Situação</th>
                        <th class="text-end">Ações</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var divida in Filtradas)
                    {
                        <tr>
                            <td>@divida.Nome</td>
                            <td>@NomeConta(divida.IdConta)</td>
                            <td>@NomeCategoria(divida.IdCategoria)</td>
                            <td>@NomeCredor(divida.IdCredor)</td>
                            <td class="text-end">@Formato.Moeda(divida.Valor)</td>
                            <td class="text-end">@divida.Parcelas</td>
                            <td>@Formato.Data(divida.DataPrimeiroVencimento)</td>
                            <td><Situacao Ativo="divida.Ativo" /></td>
                            <td class="text-end">
                                <AcoesLinha UrlEditar="@($"/dividas/{divida.Id}/editar")"
                                            Ativo="divida.Ativo"
                                            OnInativar="() => InativarAsync(divida.Id)"
                                            OnExcluir="() => ExcluirAsync(divida.Id)" />
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>

        <p class="text-muted small">@Filtradas.Count() de @_dividas.Count registro(s).</p>
    }
}

@code {
    private List<DividaDto>? _dividas;

    // Listas auxiliares só para trocar os ids das FKs pelos nomes na tabela.
    private Dictionary<int, string> _contas = [];
    private Dictionary<int, string> _categorias = [];
    private Dictionary<int, string> _credores = [];

    private string _filtro = string.Empty;
    private bool _mostrarInativos;

    protected override async Task CarregarAsync()
    {
        var dividas = DividasApi.ObterTodosAsync();
        var contas = ContasApi.ObterTodosAsync();
        var categorias = CategoriasApi.ObterTodosAsync();
        var credores = CredoresApi.ObterTodosAsync();

        _dividas = (await dividas)?.OrderBy(d => d.Nome).ToList();
        _contas = (await contas)?.ToDictionary(c => c.Id, c => c.Nome) ?? [];
        _categorias = (await categorias)?.ToDictionary(c => c.Id, c => c.Nome) ?? [];
        _credores = (await credores)?.ToDictionary(c => c.Id, c => c.Nome) ?? [];
    }

    private IEnumerable<DividaDto> Filtradas => (_dividas ?? [])
        .Where(d => _mostrarInativos || d.Ativo)
        .Where(d => Filtro.Corresponde(_filtro, d.Nome));

    private string NomeConta(int id) => _contas.TryGetValue(id, out var nome) ? nome : $"#{id}";

    private string NomeCategoria(int id) => _categorias.TryGetValue(id, out var nome) ? nome : $"#{id}";

    private string NomeCredor(int? id) =>
        id is null ? "—" : _credores.TryGetValue(id.Value, out var nome) ? nome : $"#{id}";

    private async Task InativarAsync(int id)
        => await AplicarResultadoAsync(await DividasApi.InativarAsync(id), "Dívida inativada.");

    private async Task ExcluirAsync(int id)
        => await AplicarResultadoAsync(await DividasApi.ExcluirAsync(id), "Dívida excluída.");
}
