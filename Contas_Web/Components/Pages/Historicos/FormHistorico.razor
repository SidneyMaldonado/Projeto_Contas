@page "/historicos/novo"
@page "/historicos/{Id:int}/editar"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using System.ComponentModel.DataAnnotations
@inherits PaginaAutenticada
@inject HistoricosApiService HistoricosApi
@inject InvestimentosApiService InvestimentosApi

<PageTitle>@Titulo</PageTitle>

<h1 class="h3 mb-3">@Titulo</h1>

<Alerta Mensagem="@Mensagem" Sucesso="MensagemSucesso" OnFechar="LimparMensagem" />

@if (Carregando)
{
    <p>Carregando...</p>
}
else if (_naoEncontrado)
{
    <div class="alert alert-warning" role="alert">Histórico não encontrado.</div>
    <a class="btn btn-outline-secondary" href="/historicos">Voltar</a>
}
else
{
    <div class="card shadow-sm" style="max-width: 720px;">
        <div class="card-body">
            <EditForm Model="_modelo" OnValidSubmit="SalvarAsync">
                <DataAnnotationsValidator />

                <div class="mb-3">
                    <label class="form-label" for="investimento">Investimento</label>
                    <InputSelect id="investimento" class="form-select" @bind-Value="_modelo.IdInvestimento">
                        <option value="0">Selecione...</option>
                        @foreach (var investimento in _investimentos)
                        {
                            <option value="@investimento.Id">@investimento.Nome</option>
                        }
                    </InputSelect>
                    <ValidationMessage For="() => _modelo.IdInvestimento" />
                </div>

                <div class="row g-3">
                    <div class="col-md-6 mb-3">
                        <label class="form-label" for="quantidade">Quantidade</label>
                        <InputNumber id="quantidade" class="form-control" step="0.0001"
                                     @bind-Value="_modelo.Quantidade" />
                        <ValidationMessage For="() => _modelo.Quantidade" />
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label" for="cotacao">Cotação</label>
                        <InputNumber id="cotacao" class="form-control" step="0.01" @bind-Value="_modelo.Cotacao" />
                        <ValidationMessage For="() => _modelo.Cotacao" />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label" for="observacao">Observação</label>
                    <InputTextArea id="observacao" class="form-control" rows="3"
                                   @bind-Value="_modelo.Observacao" />
                    <ValidationMessage For="() => _modelo.Observacao" />
                    <div class="form-text">Obrigatória, até 500 caracteres.</div>
                </div>

                <div class="alert alert-info py-2" role="alert">
                    A data do histórico é registrada pela API no momento da inclusão e não pode ser alterada.
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary" disabled="@_salvando">
                        @(_salvando ? "Salvando..." : "Salvar")
                    </button>
                    <a class="btn btn-outline-secondary" href="/historicos">Cancelar</a>
                </div>
            </EditForm>
        </div>
    </div>
}

@code {
    [Parameter] public int? Id { get; set; }

    // Modelo próprio em vez de AdicionarHistoricoDto: aquele DTO tem NomeInvestimento
    // como [Required], e esse campo não é digitado (vem do investimento selecionado).
    // Usá-lo direto no EditForm faria a validação barrar o submit sem nada aparecer na tela.
    private sealed class ModeloHistorico
    {
        [Range(1, int.MaxValue, ErrorMessage = "Selecione o investimento.")]
        public int IdInvestimento { get; set; }

        [Range(0, double.MaxValue, ErrorMessage = "A quantidade não pode ser negativa.")]
        public decimal Quantidade { get; set; }

        [Range(0, double.MaxValue, ErrorMessage = "A cotação não pode ser negativa.")]
        public decimal Cotacao { get; set; }

        [Required(ErrorMessage = "Informe a observação.")]
        [MaxLength(500)]
        public string Observacao { get; set; } = string.Empty;
    }

    private readonly ModeloHistorico _modelo = new();

    private List<InvestimentoDto> _investimentos = [];

    private bool _naoEncontrado;
    private bool _salvando;

    private bool Editando => Id.HasValue;

    private string Titulo => Editando ? "Editar histórico" : "Novo histórico";

    protected override async Task CarregarAsync()
    {
        _investimentos = (await InvestimentosApi.ObterTodosAsync())?
            .Where(i => i.Ativo).OrderBy(i => i.Nome).ToList() ?? [];

        if (!Editando)
            return;

        var historico = await HistoricosApi.ObterPorIdAsync(Id!.Value);
        if (historico is null)
        {
            _naoEncontrado = true;
            return;
        }

        _modelo.IdInvestimento = historico.IdInvestimento;
        _modelo.Quantidade = historico.Quantidade;
        _modelo.Cotacao = historico.Cotacao;
        _modelo.Observacao = historico.Observacao;
    }

    private async Task SalvarAsync()
    {
        _salvando = true;
        LimparMensagem();

        // nm_investimento é desnormalizado e obrigatório na API: vem do investimento
        // selecionado, sem campo próprio no formulário.
        var nomeInvestimento = _investimentos
            .FirstOrDefault(i => i.Id == _modelo.IdInvestimento)?.Nome ?? string.Empty;

        var resultado = Editando
            ? await HistoricosApi.AtualizarAsync(Id!.Value, new AtualizarHistoricoDto
                {
                    IdInvestimento = _modelo.IdInvestimento,
                    NomeInvestimento = nomeInvestimento,
                    Quantidade = _modelo.Quantidade,
                    Cotacao = _modelo.Cotacao,
                    Observacao = _modelo.Observacao
                })
            : await HistoricosApi.AdicionarAsync(new AdicionarHistoricoDto
                {
                    IdInvestimento = _modelo.IdInvestimento,
                    NomeInvestimento = nomeInvestimento,
                    Quantidade = _modelo.Quantidade,
                    Cotacao = _modelo.Cotacao,
                    Observacao = _modelo.Observacao
                });

        _salvando = false;

        if (resultado.Sucesso)
        {
            Navegacao.NavigateTo("/historicos");
            return;
        }

        DefinirErro(resultado.Erro);
    }
}
