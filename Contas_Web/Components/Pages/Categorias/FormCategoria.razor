@page "/categorias/novo"
@page "/categorias/{Id:int}/editar"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inherits PaginaAutenticada
@inject CategoriasApiService CategoriasApi

<PageTitle>@Titulo</PageTitle>

<h1 class="h3 mb-3">@Titulo</h1>

<Alerta Mensagem="@Mensagem" Sucesso="MensagemSucesso" OnFechar="LimparMensagem" />

@if (Carregando)
{
    <p>Carregando...</p>
}
else if (_naoEncontrado)
{
    <div class="alert alert-warning" role="alert">Categoria não encontrada.</div>
    <a class="btn btn-outline-secondary" href="/categorias">Voltar</a>
}
else
{
    <div class="card shadow-sm" style="max-width: 640px;">
        <div class="card-body">
            <EditForm Model="_modelo" OnValidSubmit="SalvarAsync">
                <DataAnnotationsValidator />

                <div class="mb-3">
                    <label class="form-label" for="nome">Nome</label>
                    <InputText id="nome" class="form-control" @bind-Value="_modelo.Nome" />
                    <ValidationMessage For="() => _modelo.Nome" />
                    <div class="form-text">Mínimo de 3 caracteres.</div>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary" disabled="@_salvando">
                        @(_salvando ? "Salvando..." : "Salvar")
                    </button>
                    <a class="btn btn-outline-secondary" href="/categorias">Cancelar</a>
                </div>
            </EditForm>
        </div>
    </div>
}

@code {
    [Parameter] public int? Id { get; set; }

    private readonly AdicionarCategoriaDto _modelo = new();

    // CategoriaConverter.ApplyUpdate sobrescreve img_categoria com o que vier no DTO.
    private byte[]? _imagemAtual;

    private bool _naoEncontrado;
    private bool _salvando;

    private bool Editando => Id.HasValue;

    private string Titulo => Editando ? "Editar categoria" : "Nova categoria";

    protected override async Task CarregarAsync()
    {
        if (!Editando)
            return;

        var categoria = await CategoriasApi.ObterPorIdAsync(Id!.Value);
        if (categoria is null)
        {
            _naoEncontrado = true;
            return;
        }

        _modelo.Nome = categoria.Nome;
        _imagemAtual = categoria.Imagem;
    }

    private async Task SalvarAsync()
    {
        _salvando = true;
        LimparMensagem();

        _modelo.Imagem = _imagemAtual;

        var resultado = Editando
            ? await CategoriasApi.AtualizarAsync(Id!.Value, new AtualizarCategoriaDto
                {
                    Nome = _modelo.Nome,
                    Imagem = _modelo.Imagem
                })
            : await CategoriasApi.AdicionarAsync(_modelo);

        _salvando = false;

        if (resultado.Sucesso)
        {
            Navegacao.NavigateTo("/categorias");
            return;
        }

        DefinirErro(resultado.Erro);
    }
}
