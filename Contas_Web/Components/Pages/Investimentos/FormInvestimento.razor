@page "/investimentos/novo"
@page "/investimentos/{Id:int}/editar"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@inherits PaginaAutenticada
@inject InvestimentosApiService InvestimentosApi
@inject CarteirasApiService CarteirasApi

<PageTitle>@Titulo</PageTitle>

<h1 class="h3 mb-3">@Titulo</h1>

<Alerta Mensagem="@Mensagem" Sucesso="MensagemSucesso" OnFechar="LimparMensagem" />

@if (Carregando)
{
    <p>Carregando...</p>
}
else if (_naoEncontrado)
{
    <div class="alert alert-warning" role="alert">Investimento não encontrado.</div>
    <a class="btn btn-outline-secondary" href="/investimentos">Voltar</a>
}
else
{
    <div class="card shadow-sm" style="max-width: 720px;">
        <div class="card-body">
            <EditForm Model="_modelo" OnValidSubmit="SalvarAsync">
                <DataAnnotationsValidator />

                <div class="mb-3">
                    <label class="form-label" for="nome">Nome</label>
                    <InputText id="nome" class="form-control" @bind-Value="_modelo.Nome" />
                    <ValidationMessage For="() => _modelo.Nome" />
                    <div class="form-text">Até 50 caracteres.</div>
                </div>

                <div class="mb-3">
                    <label class="form-label" for="carteira">Carteira</label>
                    <InputSelect id="carteira" class="form-select" @bind-Value="_modelo.IdCarteira">
                        <option value="0">Selecione...</option>
                        @foreach (var carteira in _carteiras)
                        {
                            <option value="@carteira.Id">@carteira.Nome</option>
                        }
                    </InputSelect>
                </div>

                <div class="row g-3">
                    <div class="col-md-6 mb-3">
                        <label class="form-label" for="quantidade">Quantidade</label>
                        <InputNumber id="quantidade" class="form-control" step="0.0001"
                                     @bind-Value="_modelo.Quantidade" />
                        <ValidationMessage For="() => _modelo.Quantidade" />
                        <div class="form-text">Maior que zero.</div>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label class="form-label" for="cotacao">Cotação</label>
                        <InputNumber id="cotacao" class="form-control" step="0.01" @bind-Value="_modelo.Cotacao" />
                        <ValidationMessage For="() => _modelo.Cotacao" />
                    </div>
                </div>

                <div class="mb-3">
                    <label class="form-label" for="observacao">Observação</label>
                    <InputTextArea id="observacao" class="form-control" rows="3"
                                   @bind-Value="_modelo.Observacao" />
                    <ValidationMessage For="() => _modelo.Observacao" />
                    <div class="form-text">Até 500 caracteres.</div>
                </div>

                <div class="d-flex gap-2">
                    <button type="submit" class="btn btn-primary" disabled="@_salvando">
                        @(_salvando ? "Salvando..." : "Salvar")
                    </button>
                    <a class="btn btn-outline-secondary" href="/investimentos">Cancelar</a>
                </div>
            </EditForm>
        </div>
    </div>
}

@code {
    [Parameter] public int? Id { get; set; }

    private readonly AdicionarInvestimentoDto _modelo = new();

    private List<CarteiraDto> _carteiras = [];

    private bool _naoEncontrado;
    private bool _salvando;

    private bool Editando => Id.HasValue;

    private string Titulo => Editando ? "Editar investimento" : "Novo investimento";

    protected override async Task CarregarAsync()
    {
        _carteiras = (await CarteirasApi.ObterTodosAsync())?.Where(c => c.Ativo).OrderBy(c => c.Nome).ToList() ?? [];

        if (!Editando)
            return;

        var investimento = await InvestimentosApi.ObterPorIdAsync(Id!.Value);
        if (investimento is null)
        {
            _naoEncontrado = true;
            return;
        }

        _modelo.Nome = investimento.Nome;
        _modelo.IdCarteira = investimento.IdCarteira;
        _modelo.Quantidade = investimento.Quantidade;
        _modelo.Cotacao = investimento.Cotacao;
        _modelo.Observacao = investimento.Observacao;
    }

    private async Task SalvarAsync()
    {
        LimparMensagem();

        // [Required] em int é no-op no DataAnnotationsValidator: a opção "Selecione..."
        // vale 0 e passaria pela validação do EditForm.
        if (_modelo.IdCarteira == 0)
        {
            DefinirErro("Selecione a carteira.");
            return;
        }

        _salvando = true;

        var resultado = Editando
            ? await InvestimentosApi.AtualizarAsync(Id!.Value, new AtualizarInvestimentoDto
                {
                    IdCarteira = _modelo.IdCarteira,
                    Nome = _modelo.Nome,
                    Quantidade = _modelo.Quantidade,
                    Cotacao = _modelo.Cotacao,
                    Observacao = _modelo.Observacao
                })
            : await InvestimentosApi.AdicionarAsync(_modelo);

        _salvando = false;

        if (resultado.Sucesso)
        {
            Navegacao.NavigateTo("/investimentos");
            return;
        }

        DefinirErro(resultado.Erro);
    }
}
