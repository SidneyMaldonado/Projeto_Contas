@* Campo de busca + alternar inativos + botão Novo, comum a todas as listagens. *@

<div class="row g-2 align-items-center mb-3">
    <div class="col-sm-6 col-lg-4">
        <input type="search" class="form-control" placeholder="@Placeholder"
               value="@Texto" @oninput="AoDigitarAsync" />
    </div>

    <div class="col-auto">
        <div class="form-check mb-0">
            <input class="form-check-input" type="checkbox" id="@_idCheckbox"
                   checked="@MostrarInativos" @onchange="AoAlternarInativosAsync" />
            <label class="form-check-label" for="@_idCheckbox">Mostrar inativos</label>
        </div>
    </div>

    <div class="col-auto ms-auto">
        <a class="btn btn-primary" href="@UrlNovo">Novo</a>
    </div>
</div>

@code {
    private readonly string _idCheckbox = $"inativos-{Guid.NewGuid():N}";

    [Parameter] public string Texto { get; set; } = string.Empty;

    [Parameter] public EventCallback<string> TextoChanged { get; set; }

    [Parameter] public bool MostrarInativos { get; set; }

    [Parameter] public EventCallback<bool> MostrarInativosChanged { get; set; }

    [Parameter] public string Placeholder { get; set; } = "Filtrar por nome";

    [Parameter, EditorRequired] public string UrlNovo { get; set; } = string.Empty;

    private Task AoDigitarAsync(ChangeEventArgs e)
        => TextoChanged.InvokeAsync(e.Value?.ToString() ?? string.Empty);

    private Task AoAlternarInativosAsync(ChangeEventArgs e)
        => MostrarInativosChanged.InvokeAsync(e.Value is true);
}
