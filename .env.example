# Copie este arquivo para .env e preencha os valores.
#   Windows: copy .env.example .env
# O .env contem credenciais e esta no .gitignore -- nao versione.

# --- Banco de dados ---
# Use um login SQL Server (autenticacao SQL). Integrated Security nao funciona
# em container Linux.
DB_SERVER=MS211,1434
DB_NAME=test_fin
DB_USER=
DB_PASSWORD=

# --- Aplicacao ---
# Development expoe o Swagger em /swagger; Production nao.
ASPNETCORE_ENVIRONMENT=Development

# Porta no host (a porta interna do container e sempre 8080).
API_PORT=5210
