<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:services="clr-namespace:Contas_App.Services"
             x:Class="Contas_App.MainPage"
             BackgroundImageSource="fundo.png"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*,Auto" Padding="24">

        <Label Grid.Row="0"
               Text="Vida dura"
               FontSize="34"
               FontAttributes="Bold"
               TextColor="{StaticResource Gold}"
               HorizontalOptions="Center"
               Margin="0,60,0,0" />

        <Border Grid.Row="1"
                Stroke="{StaticResource Gold}"
                StrokeThickness="2"
                StrokeShape="RoundRectangle 20"
                BackgroundColor="#B3000000"
                Padding="20"
                Margin="0,24,0,16">

            <Grid RowDefinitions="Auto,Auto,*,Auto,Auto" RowSpacing="8">

                <Grid Grid.Row="0" ColumnDefinitions="*,Auto">
                    <Label Text="Conta"
                           TextColor="{StaticResource Gold}"
                           FontAttributes="Bold"
                           FontSize="14" />
                    <Label Grid.Column="1"
                           Text="Saldo"
                           TextColor="{StaticResource Gold}"
                           FontAttributes="Bold"
                           FontSize="14"
                           HorizontalTextAlignment="End"
                           WidthRequest="130" />
                </Grid>

                <BoxView Grid.Row="1"
                         HeightRequest="1"
                         Color="{StaticResource Gold}" />

                <CollectionView Grid.Row="2" x:Name="ContasCollection">
                    <CollectionView.EmptyView>
                        <Label Text="Nenhuma conta cadastrada."
                               TextColor="{StaticResource Gray200}"
                               FontSize="14"
                               Margin="0,12,0,0" />
                    </CollectionView.EmptyView>

                    <CollectionView.ItemTemplate>
                        <DataTemplate x:DataType="services:ContaSaldoItem">
                            <Grid ColumnDefinitions="*,Auto" Padding="0,8">

                                <Label Text="{Binding Nome}"
                                       TextColor="White"
                                       FontSize="15"
                                       VerticalOptions="Center" />

                                <Label Grid.Column="1"
                                       Text="{Binding SaldoFormatado}"
                                       TextColor="White"
                                       FontSize="15"
                                       HorizontalTextAlignment="End"
                                       VerticalOptions="Center"
                                       WidthRequest="130"
                                       IsVisible="{Binding EmExibicao}" />

                                <Entry Grid.Column="1"
                                       Text="{Binding SaldoTexto, Mode=TwoWay}"
                                       TextColor="White"
                                       FontSize="15"
                                       HorizontalTextAlignment="End"
                                       VerticalOptions="Center"
                                       WidthRequest="130"
                                       Keyboard="Numeric"
                                       IsVisible="{Binding EmEdicao}" />

                            </Grid>
                        </DataTemplate>
                    </CollectionView.ItemTemplate>
                </CollectionView>

                <BoxView Grid.Row="3"
                         HeightRequest="1"
                         Color="{StaticResource Gold}" />

                <Grid Grid.Row="4" ColumnDefinitions="*,Auto">
                    <Label Text="Total"
                           TextColor="{StaticResource Gold}"
                           FontAttributes="Bold"
                           FontSize="15"
                           VerticalOptions="Center" />
                    <Label Grid.Column="1"
                           x:Name="TotalLabel"
                           Text="R$ 0,00"
                           TextColor="{StaticResource Gold}"
                           FontAttributes="Bold"
                           FontSize="15"
                           HorizontalTextAlignment="End"
                           VerticalOptions="Center"
                           WidthRequest="130" />
                </Grid>

            </Grid>
        </Border>

        <VerticalStackLayout Grid.Row="2" Spacing="8" Margin="0,0,0,30">

            <ActivityIndicator x:Name="LoadingIndicator"
                               IsVisible="False"
                               IsRunning="False"
                               Color="{StaticResource Gold}" />

            <Label x:Name="StatusLabel"
                   TextColor="OrangeRed"
                   FontSize="13"
                   HorizontalTextAlignment="Center"
                   IsVisible="False" />

            <Button x:Name="AtualizarSaldosButton"
                    Text="Atualizar Saldos"
                    BackgroundColor="{StaticResource Gold}"
                    TextColor="Black"
                    FontAttributes="Bold"
                    Clicked="OnAtualizarSaldosClicked" />

            <Button x:Name="SalvarButton"
                    Text="Salvar"
                    BackgroundColor="{StaticResource Gold}"
                    TextColor="Black"
                    FontAttributes="Bold"
                    IsVisible="False"
                    Clicked="OnSalvarClicked" />

        </VerticalStackLayout>

    </Grid>
</ContentPage>
