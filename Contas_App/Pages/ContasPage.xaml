<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:services="clr-namespace:Contas_App.Services"
             x:Class="Contas_App.Pages.ContasPage"
             BackgroundImageSource="fundo.png"
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>

        <!-- Um template só para as duas listas: a diferença entre pagar e receber está na
             moldura do bloco, não na linha. -->
        <DataTemplate x:Key="LinhaMovimento" x:DataType="services:MovimentoItem">
            <Grid ColumnDefinitions="*,50,110" Padding="0,6">

                <Label Text="{Binding Nome}"
                       TextColor="{Binding Cor}"
                       FontSize="14"
                       LineBreakMode="TailTruncation"
                       VerticalOptions="Center" />

                <Label Grid.Column="1"
                       Text="{Binding Vencimento}"
                       TextColor="{Binding Cor}"
                       FontSize="14"
                       HorizontalTextAlignment="Center"
                       VerticalOptions="Center" />

                <Label Grid.Column="2"
                       Text="{Binding ValorFormatado}"
                       TextColor="{Binding Cor}"
                       FontSize="14"
                       HorizontalTextAlignment="End"
                       VerticalOptions="Center" />

            </Grid>
        </DataTemplate>

    </ContentPage.Resources>

    <Grid RowDefinitions="Auto,*,Auto" Padding="24">

        <Label Grid.Row="0"
               Text="Contas do mês"
               FontSize="28"
               FontAttributes="Bold"
               TextColor="{StaticResource Gold}"
               HorizontalOptions="Center"
               Margin="0,60,0,0" />

        <ScrollView Grid.Row="1" Margin="0,16,0,8">
            <VerticalStackLayout Spacing="16">

                <!-- A pagar -->
                <Border Stroke="{StaticResource Despesa}"
                        StrokeThickness="2"
                        StrokeShape="RoundRectangle 20"
                        BackgroundColor="#B3000000"
                        Padding="16">

                    <VerticalStackLayout Spacing="6">

                        <Grid ColumnDefinitions="*,50,110">
                            <Label Text="Credor"
                                   TextColor="{StaticResource Despesa}"
                                   FontAttributes="Bold"
                                   FontSize="14" />
                            <Label Grid.Column="1"
                                   Text="Venc."
                                   TextColor="{StaticResource Despesa}"
                                   FontAttributes="Bold"
                                   FontSize="14"
                                   HorizontalTextAlignment="Center" />
                            <Label Grid.Column="2"
                                   x:Name="MesPagarLabel"
                                   Text="Mês"
                                   TextColor="{StaticResource Despesa}"
                                   FontAttributes="Bold"
                                   FontSize="14"
                                   HorizontalTextAlignment="End" />
                        </Grid>

                        <BoxView HeightRequest="1" Color="{StaticResource Despesa}" />

                        <VerticalStackLayout x:Name="PagarLista">
                            <BindableLayout.ItemTemplate>
                                <StaticResource Key="LinhaMovimento" />
                            </BindableLayout.ItemTemplate>
                            <BindableLayout.EmptyView>
                                <Label Text="Nada a pagar neste mês."
                                       TextColor="{StaticResource Gray200}"
                                       FontSize="14"
                                       Margin="0,8" />
                            </BindableLayout.EmptyView>
                        </VerticalStackLayout>

                        <BoxView HeightRequest="1" Color="{StaticResource Despesa}" />

                        <Grid ColumnDefinitions="*,110">
                            <Label Text="Total"
                                   TextColor="{StaticResource Despesa}"
                                   FontAttributes="Bold"
                                   FontSize="15" />
                            <Label Grid.Column="1"
                                   x:Name="TotalPagarLabel"
                                   Text="0,00"
                                   TextColor="{StaticResource Despesa}"
                                   FontAttributes="Bold"
                                   FontSize="15"
                                   HorizontalTextAlignment="End" />
                        </Grid>

                    </VerticalStackLayout>
                </Border>

                <!-- A receber -->
                <Border Stroke="{StaticResource Receita}"
                        StrokeThickness="2"
                        StrokeShape="RoundRectangle 20"
                        BackgroundColor="#B3000000"
                        Padding="16">

                    <VerticalStackLayout Spacing="6">

                        <Grid ColumnDefinitions="*,50,110">
                            <Label Text="Receita"
                                   TextColor="{StaticResource Receita}"
                                   FontAttributes="Bold"
                                   FontSize="14" />
                            <Label Grid.Column="1"
                                   Text="Venc."
                                   TextColor="{StaticResource Receita}"
                                   FontAttributes="Bold"
                                   FontSize="14"
                                   HorizontalTextAlignment="Center" />
                            <Label Grid.Column="2"
                                   x:Name="MesReceberLabel"
                                   Text="Mês"
                                   TextColor="{StaticResource Receita}"
                                   FontAttributes="Bold"
                                   FontSize="14"
                                   HorizontalTextAlignment="End" />
                        </Grid>

                        <BoxView HeightRequest="1" Color="{StaticResource Receita}" />

                        <VerticalStackLayout x:Name="ReceberLista">
                            <BindableLayout.ItemTemplate>
                                <StaticResource Key="LinhaMovimento" />
                            </BindableLayout.ItemTemplate>
                            <BindableLayout.EmptyView>
                                <Label Text="Nada a receber neste mês."
                                       TextColor="{StaticResource Gray200}"
                                       FontSize="14"
                                       Margin="0,8" />
                            </BindableLayout.EmptyView>
                        </VerticalStackLayout>

                        <BoxView HeightRequest="1" Color="{StaticResource Receita}" />

                        <Grid ColumnDefinitions="*,110">
                            <Label Text="Total"
                                   TextColor="{StaticResource Receita}"
                                   FontAttributes="Bold"
                                   FontSize="15" />
                            <Label Grid.Column="1"
                                   x:Name="TotalReceberLabel"
                                   Text="0,00"
                                   TextColor="{StaticResource Receita}"
                                   FontAttributes="Bold"
                                   FontSize="15"
                                   HorizontalTextAlignment="End" />
                        </Grid>

                    </VerticalStackLayout>
                </Border>

                <!-- Fechamento do mês -->
                <Border Stroke="{StaticResource Gold}"
                        StrokeThickness="2"
                        StrokeShape="RoundRectangle 20"
                        BackgroundColor="#B3000000"
                        Padding="16">

                    <VerticalStackLayout Spacing="6">

                        <Grid ColumnDefinitions="*,110">
                            <Label Text="Receitas"
                                   TextColor="White"
                                   FontSize="14" />
                            <Label Grid.Column="1"
                                   x:Name="ResumoReceitasLabel"
                                   Text="0,00"
                                   TextColor="White"
                                   FontSize="14"
                                   HorizontalTextAlignment="End" />
                        </Grid>

                        <Grid ColumnDefinitions="*,110">
                            <Label Text="Despesas"
                                   TextColor="White"
                                   FontSize="14" />
                            <Label Grid.Column="1"
                                   x:Name="ResumoDespesasLabel"
                                   Text="0,00"
                                   TextColor="White"
                                   FontSize="14"
                                   HorizontalTextAlignment="End" />
                        </Grid>

                        <BoxView HeightRequest="1" Color="{StaticResource Gold}" />

                        <Grid ColumnDefinitions="*,110">
                            <Label Text="Diferença"
                                   TextColor="{StaticResource Gold}"
                                   FontAttributes="Bold"
                                   FontSize="16" />
                            <Label Grid.Column="1"
                                   x:Name="DiferencaLabel"
                                   Text="0,00"
                                   TextColor="{StaticResource Gold}"
                                   FontAttributes="Bold"
                                   FontSize="16"
                                   HorizontalTextAlignment="End" />
                        </Grid>

                    </VerticalStackLayout>
                </Border>

            </VerticalStackLayout>
        </ScrollView>

        <VerticalStackLayout Grid.Row="2" Spacing="8" Margin="0,0,0,30">

            <ActivityIndicator x:Name="LoadingIndicator"
                               IsVisible="False"
                               IsRunning="False"
                               Color="{StaticResource Gold}" />

            <Label x:Name="StatusLabel"
                   TextColor="OrangeRed"
                   FontSize="13"
                   HorizontalTextAlignment="Center"
                   IsVisible="False" />

            <Button x:Name="RecarregarButton"
                    Text="Recarregar"
                    BackgroundColor="Transparent"
                    BorderColor="{StaticResource Gold}"
                    BorderWidth="2"
                    TextColor="{StaticResource Gold}"
                    FontAttributes="Bold"
                    Clicked="OnRecarregarClicked" />

        </VerticalStackLayout>

    </Grid>
</ContentPage>
